# TrustLens -- production configuration
#
#   cp .env.production.example .env.production
#   bash scripts/generate-keys.sh >> .env.production
#   # edit POSTGRES_PASSWORD and STORAGE_SECRET_ACCESS_KEY below
#   make prod-up            (or prod-start.bat on Windows)
#
# NEVER COMMIT .env.production. `.gitignore` already blocks it.
#
# --------------------------------------------------------------------
# HOW TO MOVE A PIECE TO A HOSTED PROVIDER
# --------------------------------------------------------------------
#
# Everything below runs locally by default, and every backing service is
# reached ONLY through a URL in this file. To move one to a managed provider,
# change its URL and stop the local container. No code change, no rebuild.
#
#   Postgres  -> DATABASE_URL + DATABASE_URL_SYNC
#   Redis     -> REDIS_URL + REDIS_QUEUE_URL
#   Storage   -> STORAGE_ENDPOINT_URL + the two keys
#   Email     -> EMAIL_PROVIDER=resend + RESEND_API_KEY
#
# Ready-made values for common providers are at the bottom of this file.
#
# The ONE exception is NEXT_PUBLIC_API_BASE_URL. It is compiled into the
# browser bundle, so changing it needs `make prod-build`, not a restart. This
# catches everyone once.

# -- Runtime ----------------------------------------------------------
# `staging` for a local stack, `production` for a real public deployment.
#
# This is production MODE either way - built Next.js servers, uvicorn with
# workers, migrations as a release step. The difference is a hardening
# validator that only fires on ENV=production and refuses to boot unless:
#
#     DB_SSL_REQUIRE=true                 (TLS to the database)
#     USE_FAKE_AI=false                   (real OCR and face matching)
#     SECURITY_API_KEY_PREFIX=tl_live     (live partner keys)
#     SECURITY_CORS_ORIGINS               (an explicit allowlist, no '*')
#     DEBUG=false  and  LOG_FORMAT=json
#
# All correct once the system is on the internet, and all wrong on a laptop
# with a local Postgres. Set `production` when you deploy and let the
# validator tell you what is still missing - do not weaken the check.
ENV=staging
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
TZ=Asia/Karachi

# -- Ports on the host machine ----------------------------------------
# Change these if something else already uses them.
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=8000
MAILPIT_UI_PORT=8025
MINIO_CONSOLE_PORT=9001

# -- URLs -------------------------------------------------------------
# For a demo on one laptop, leave these. To reach it from a phone on the same
# WiFi, replace localhost with the machine's LAN IP (e.g. 192.168.1.20)
# EVERYWHERE below, then run `make prod-build` - the browser bundle carries
# NEXT_PUBLIC_API_BASE_URL, so a restart alone will not pick it up.
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_ENV=production
SECURITY_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Host headers the API will answer to. `api` is the service name on the compose
# network: the web container server-renders through http://api:8000, and
# without it here TrustedHostMiddleware returns 400 and the buyer page renders
# not-found for every seller while the API looks perfectly healthy.
# Add your real domain here when you deploy.
SECURITY_TRUSTED_HOSTS=localhost,127.0.0.1,api,web,admin

# WARNING: no MFA enrolment or verification endpoint exists yet. Listing a
# role here (e.g. ADMIN,REVIEWER) makes login return MFA_REQUIRED for that
# role with no way to satisfy it, permanently locking those accounts out -
# the API refuses to boot rather than let that happen silently. Leave this
# empty until MFA enrolment is built. See REMAINING.md Stage 4 (P4-09).
SECURITY_MFA_REQUIRED_ROLES=

# -- Database ---------------------------------------------------------
# CHANGE THE PASSWORD before running anything you would be sad to lose.
POSTGRES_USER=trustlens
POSTGRES_PASSWORD=change-me-before-first-boot
POSTGRES_DB=trustlens

# `postgres` is the container name on the compose network. Point these at a
# hosted database and stop the local container to migrate away.
DATABASE_URL=postgresql+asyncpg://trustlens:change-me-before-first-boot@postgres:5432/trustlens
DATABASE_URL_SYNC=postgresql+psycopg://trustlens:change-me-before-first-boot@postgres:5432/trustlens
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Managed Postgres almost always requires TLS. Local does not.
DB_SSL_REQUIRE=false

# -- Redis ------------------------------------------------------------
# Two logical databases on purpose: 0 is a disposable cache, 1 is the job
# queue and must survive a restart. Flushing the cache must never drop a
# verification job a user was already told had been accepted.
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_URL=redis://redis:6379/1

# -- Object storage ---------------------------------------------------
# MinIO locally, S3-compatible anywhere. CHANGE THE SECRET KEY.
#
# WARNING: `http://minio:9000` is the compose-network-only hostname - it
# resolves for the api/worker containers but NOT for a browser, so image
# upload/download URLs built from it would be unreachable outside the
# server. Port 9000 (the S3 API, not the 9001 console) is published on the
# host, so once you deploy, replace this with an address a browser can
# actually reach: `http://<server-ip-or-domain>:9000` for a plain
# self-host, or your reverse-proxy's public HTTPS address if you put one in
# front of it. The API/worker containers reach the same address you give a
# browser - there is deliberately only one endpoint here, not an internal
# one plus a separate public one, so signing and serving can never drift
# apart. Set ENV=production (not the staging default) and this file's own
# hardening check will refuse to boot if this still says `minio:9000`.
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=trustlens
STORAGE_SECRET_ACCESS_KEY=change-me-before-first-boot
STORAGE_BUCKET_DOCUMENTS=trustlens-documents
STORAGE_BUCKET_LISTINGS=trustlens-listings
# CNIC and selfie images are deleted this many days after the decision plus
# the appeal window. Holding biometric data longer than needed is the kind of
# thing a data-protection regime asks about.
MEDIA_RETENTION_DAYS_IDENTITY=90

# -- Secrets ----------------------------------------------------------
# DO NOT type these by hand:
#
#     bash scripts/generate-keys.sh >> .env.production
#
# It appends SECURITY_JWT_PRIVATE_KEY, SECURITY_JWT_PUBLIC_KEY,
# SECURITY_OTP_PEPPER, SECURITY_TOKEN_PEPPER, SECURITY_ENCRYPTION_KEY and
# REVALIDATE_SECRET. The stack refuses to start without them, on purpose -
# a default secret that boots is a default secret that ships.
#
# Optional: lets partner marketplaces verify a score came from you.
SECURITY_RESPONSE_SIGNING_SECRET=
SECURITY_RESPONSE_SIGNING_KEY_ID=k1

# Required, and easy to miss: `SecuritySettings` has no default for these, so
# the app refuses to start without them rather than signing tokens with a
# guessed issuer. The seed step is where a missing one first shows up.
SECURITY_JWT_ALGORITHM=EdDSA
SECURITY_JWT_ISSUER=http://localhost:8000
SECURITY_JWT_AUDIENCE=trustlens-web

# -- AI ---------------------------------------------------------------
# true  = deterministic stand-ins. No API keys, no internet, and every
#         journey still works end to end. This is the right setting for a
#         demo and for a machine with no credit card attached.
# false = real engines. Needs the models present in the worker image (they
#         are baked in) and an LLM key below for listing analysis.
USE_FAKE_AI=true

# ONNX runtimes: ~1.16 GB image, 323 MB RAM. The PyTorch/TensorFlow pair
# (easyocr / deepface) is still selectable for the Phase 1 benchmark.
OCR_ENGINE=rapidocr
FACE_ENGINE=insightface
OCR_LANGUAGES=en
FACE_MATCH_THRESHOLD=0.70
FACE_MATCH_REVIEW_LOWER=0.55

# Listing analysis. Leave blank to keep the deterministic analyser.
AI_PROVIDER=openai
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=10

# The trained scam classifier. Read apps/ml/README.md before setting
# USE_FAKE_AI=false with this enabled: on Pakistani marketplace ads the
# shipped model catches 1 scam in 7, and its output feeds a seller's score.
CLASSIFIER_MODEL_VERSION=scamclf-v1
# Blank = use the threshold the model was calibrated with. Set a number only
# to move the operating point deliberately.
CLASSIFIER_THRESHOLD=

# -- Email ------------------------------------------------------------
# Default catches every message in Mailpit at http://localhost:8025 - nothing
# leaves the machine, and verification links are visible for a demo.
#
# For real delivery: EMAIL_PROVIDER=resend, add the key, and set up SPF, DKIM
# and DMARC on the sending domain. Without those records the mail is accepted
# and then silently filed as spam, so signup breaks with no error anywhere.
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@trustlens.local
EMAIL_FROM_NAME=TrustLens
SMTP_HOST=mailpit
SMTP_PORT_INTERNAL=1025
SMTP_TLS=false
RESEND_API_KEY=

# -- SMS --------------------------------------------------------------
# Console by default: the OTP is printed to the worker log. Twilio trial works
# for a demo. Real SMS in Pakistan needs PTA registration and a per-carrier
# sender ID against an NTN - a deployment constraint, not a defect.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_LENGTH=6
OTP_TTL_SECONDS=600

# -- Google sign-in -----------------------------------------------------
# Optional: "Continue with Google" degrades to "not offered" when either is
# unset. Redirect URI must be registered in Cloud Console exactly:
# {API_BASE_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# -- IP intelligence --------------------------------------------------
# Accepted values: offline | ipqualityscore | ipapi
#
# NOT proxycheck.io or vpnapi.io - an earlier planning document named those,
# but they are not implemented. Setting one would fail at startup.
#
# `offline` uses local heuristics and needs no account. Any real provider
# FAILS OPEN: their outage must never cost a seller points on a signal they
# cannot appeal, because they did nothing wrong.
#
# Setup: ACCOUNTS.md section 2.
IP_INTEL_PROVIDER=offline
IP_INTEL_API_KEY=

# -- Capacity ---------------------------------------------------------
API_WORKERS=2
WORKER_CONCURRENCY=4
# Measured 323 MB peak with both ONNX engines resident. Set above that so a
# real leak trips the limit and a busy job does not.
WORKER_MEM_LIMIT=768m

# -- Rate limits ------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANON_PER_MINUTE=60
# Per-IP login attempts. Stops one address spraying one password across many
# accounts - the per-account lockout cannot see that attack at all.
RATE_LIMIT_LOGIN_IP_PER_15MIN=30
RATE_LIMIT_USER_PER_MINUTE=300
RATE_LIMIT_PUBLIC_API_FREE_PER_MINUTE=60
RATE_LIMIT_PUBLIC_API_PARTNER_PER_MINUTE=600
# The partner API fails CLOSED when Redis is down - refusing traffic is safer
# than removing the only control on cost. The buyer page fails open instead,
# so a Redis blip cannot blank the product's front screen.
RATE_LIMIT_FAIL_MODE=closed

# -- Monitoring -------------------------------------------------------
# Blank = structured JSON logs only, which is a working setup: `make prod-logs`
# shows everything. Add a Sentry DSN (free tier) to get alerted instead of
# finding out from a user.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true

# --------------------------------------------------------------------
# READY-MADE VALUES FOR HOSTED PROVIDERS
# --------------------------------------------------------------------
#
# Neon / Supabase / any managed Postgres
#   DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/DB?ssl=require
#   DATABASE_URL_SYNC=postgresql+psycopg://USER:PASS@HOST/DB?sslmode=require
#   DB_SSL_REQUIRE=true
#   then: docker compose ... up -d --scale postgres=0
#   !! Neon's free tier sleeps after 5 minutes idle - the first request after
#      that takes 3-5 seconds. Open the site once before a demo.
#
# Upstash / any managed Redis
#   REDIS_URL=rediss://default:PASS@HOST:PORT/0
#   REDIS_QUEUE_URL=rediss://default:PASS@HOST:PORT/1
#   !! Upstash closes idle connections by design. The worker's supervisor
#      reconnects on its own (P9-09), which is why that fix came first.
#
# Cloudflare R2
#   STORAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
#   STORAGE_REGION=auto
#   STORAGE_ACCESS_KEY_ID=...
#   STORAGE_SECRET_ACCESS_KEY=...
#
# Resend
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=re_...
#   EMAIL_FROM=no-reply@yourdomain.com     (must be a verified domain)
#
# Public hosting, whatever the platform
#   Set every URL above to the real https:// hostnames, put SECURITY_CORS_ORIGINS
#   to match, run `make prod-build`, and put a reverse proxy with TLS in front.
#   The containers speak plain HTTP on purpose - terminate TLS at the proxy.
