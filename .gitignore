# =====================================================================
#  TrustLens - polyglot monorepo (TypeScript + Python)
#
#  Rule of thumb: ignore anything that is generated, machine-specific, or
#  secret. Everything a teammate needs to reproduce the project is committed.
# =====================================================================

# ── Secrets & environment ────────────────────────────────────────────
# Only .env.example is committed; it holds CHANGEME placeholders, never values.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/
credentials.json
service-account*.json
# Generated by scripts/generate-keys.sh
jwt.pem
jwt.pub

# ── JavaScript / TypeScript ──────────────────────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/cache
.yarn/install-state.gz

# Build output
dist/
build/
out/
*.tsbuildinfo
.next/
.vercel/
.turbo/

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.venv-check/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tox/
.nox/
.hypothesis/
.dmypy.json
dmypy.json

# ── Testing & coverage ───────────────────────────────────────────────
coverage/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
junit.xml
# Playwright
playwright-report/
test-results/
blob-report/
.playwright/
# k6
testing/load/results/

# ── ML artifacts ─────────────────────────────────────────────────────
# The model registry (object storage) is the source of truth, not the repo.
# apps/ml/data/labels/ IS committed - the hand-labelled ground truth is the
# most expensive artifact the team produces and must stay reviewable.
apps/ml/data/raw/
apps/ml/data/processed/
apps/ml/models/
*.pkl
*.joblib
*.onnx
*.h5
*.pt
*.pth
*.safetensors
# DeepFace / EasyOCR weight caches
.deepface/
.EasyOCR/

# ── Local infrastructure ─────────────────────────────────────────────
.docker-data/
pgdata/
redisdata/
miniodata/
backups/
*.dump
*.sql.gz

# ── Logs ─────────────────────────────────────────────────────────────
*.log
logs/

# ── Editor & OS ──────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~
.ipynb_checkpoints/
# Team-shared VS Code settings ARE committed; personal overrides are not.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.vscode/*.local.json

# ── Sensitive: identity documents must NEVER be committed ────────────
# TrustLens processes national ID cards and selfies. A real CNIC image in git
# history is an irreversible data-protection failure - history rewriting does
# not undo a push. Test fixtures must be SYNTHETIC only (docs/10 section 8).
**/uploads/
**/real-cnic/
**/real-documents/
*.cnic.jpg
*.cnic.jpeg
*.cnic.png
*.selfie.jpg
*.selfie.png
testing/data/real/

# ── Generated, but intentionally COMMITTED (do not ignore) ───────────
# packages/api-client/src/schema.gen.ts  - CI checks it for drift (ADR-0005)
# docs/api/openapi.json                  - the published API contract
# pnpm-lock.yaml, uv.lock                - reproducible installs
