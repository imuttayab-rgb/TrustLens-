# TrustLens -- frontends on Vercel, database on Neon
#
#   make hosted-init          creates .env.hosted with real secrets
#   ...fill in the values marked FILL IN...
#   make hosted-migrate       create the schema on Neon
#   make hosted-up            start api + worker
#
# NEVER COMMIT .env.hosted.
#
# --------------------------------------------------------------------
# WHAT RUNS WHERE
# --------------------------------------------------------------------
#
#   web, admin   -> Vercel      (two projects, see ACCOUNTS.md)
#   Postgres     -> Neon
#   api, worker  -> your host   (make hosted-up)
#   Redis        -> local container by default, or Upstash
#   Storage      -> Cloudflare R2, or a local MinIO
#
# The api and worker cannot go on Vercel: the worker is an always-on process
# holding ~323 MB of AI models, and Vercel runs functions. One small 512 MB
# instance covers both -- about $3-4/month, and the only thing here that costs.

# -- Runtime ----------------------------------------------------------
ENV=staging
LOG_LEVEL=INFO
LOG_FORMAT=json

# -- Neon -------------------------------------------------------------
# From the Neon dashboard: Connection Details -> connection string.
#
# The two URLs are NOT the same, and this is the step people get wrong:
#
#   DATABASE_URL       postgresql+asyncpg://...   NO sslmode -- asyncpg rejects it.
#                                                 TLS comes from DB_SSL_REQUIRE.
#   DATABASE_URL_SYNC  postgresql+psycopg://...   MUST end ?sslmode=require --
#                                                 Alembic uses it verbatim.
#
# Paste Neon's URL as-is into both and the app fails at connect time with an
# error that names neither the parameter nor the driver. The settings
# validator now refuses to start instead, and says which one is wrong.
#
# FILL IN
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb
DATABASE_URL_SYNC=postgresql+psycopg://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DB_SSL_REQUIRE=true
# Neon's free tier sleeps the compute after 5 minutes idle and closes idle
# connections. A small pool that recycles often survives that; a big one sits
# holding dead handles.
DB_POOL_SIZE=5
DB_POOL_RECYCLE=300

# -- Redis ------------------------------------------------------------
# Local container by default. For Upstash, swap both lines and delete the
# redis service from docker-compose.hosted.yml.
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_URL=redis://redis:6379/1
# Upstash:
#   REDIS_URL=rediss://default:PASS@HOST:PORT/0
#   REDIS_QUEUE_URL=rediss://default:PASS@HOST:PORT/1

# -- Storage ----------------------------------------------------------
# Local MinIO by default - CNIC images, selfies and listing photos stay on
# this machine. Nothing to sign up for.
#
# CHANGE THE SECRET KEY before first boot; it is also the MinIO login.
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=trustlens
STORAGE_SECRET_ACCESS_KEY=change-me-before-first-boot
#
# For Cloudflare R2 later, swap these three and delete the minio + minio-init
# services from docker-compose.hosted.yml:
#   STORAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
#   STORAGE_REGION=auto
#   STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY from the R2 token
STORAGE_BUCKET_DOCUMENTS=trustlens-documents
STORAGE_BUCKET_LISTINGS=trustlens-listings
MEDIA_RETENTION_DAYS_IDENTITY=90

# -- URLs -------------------------------------------------------------
# FILL IN, all of them, with the real public addresses.
#
# API_BASE_URL is where your api+worker host is reachable. Vercel has no
# private network to your box, so the frontends call it over the internet --
# it must be publicly resolvable and, in a browser, HTTPS.
API_BASE_URL=https://api.yourdomain.com
WEB_BASE_URL=https://trustlens-web.vercel.app
ADMIN_BASE_URL=https://trustlens-admin.vercel.app

# The JWT issuer must match the public API URL, or tokens minted here are
# rejected by their own audience check.
SECURITY_JWT_ISSUER=https://api.yourdomain.com
SECURITY_JWT_AUDIENCE=trustlens-web

# Two different mechanisms, both required, both silent when wrong:
#   CORS_ORIGINS   the browser's Origin. Missing -> the browser blocks the call.
#   TRUSTED_HOSTS  the request's Host. Missing -> the API answers 400 to everything.
SECURITY_CORS_ORIGINS=https://trustlens-web.vercel.app,https://trustlens-admin.vercel.app
SECURITY_TRUSTED_HOSTS=api.yourdomain.com,localhost,127.0.0.1
# How many proxy hops to trust for the client IP. 1 behind a single reverse
# proxy or platform load balancer. Too high and a client can spoof its own IP,
# defeating rate limiting and the NETWORK signal.
SECURITY_TRUSTED_PROXY_COUNT=1

# -- Secrets ----------------------------------------------------------
# `make hosted-init` appends these. Do not type them by hand.
SECURITY_RESPONSE_SIGNING_SECRET=
SECURITY_RESPONSE_SIGNING_KEY_ID=k1

# -- AI ---------------------------------------------------------------
# Keep true until the accuracy work (P1-01) is done. Every journey works.
USE_FAKE_AI=true
OCR_ENGINE=rapidocr
FACE_ENGINE=insightface
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
CLASSIFIER_MODEL_VERSION=scamclf-v1
CLASSIFIER_THRESHOLD=

# -- Email ------------------------------------------------------------
# Three options. The default needs no account and no domain.
#
# (A) LOCAL SINK - the default. Every message lands at http://localhost:8025
#     and never leaves the machine. Perfect while developing; useless if
#     someone else needs to receive a verification link.
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=no-reply@trustlens.local
EMAIL_FROM_NAME=TrustLens
#
# (B) GMAIL - real email, free, NO DOMAIN NEEDED. Roughly 500/day, which is
#     far more than an FYP will ever send. Uses the same SMTP code as (A),
#     so there is nothing to install.
#
#     Google removed plain-password SMTP, so you need an App Password:
#       1. Turn on 2-Step Verification on the Google account
#       2. myaccount.google.com/apppasswords -> create one for "TrustLens"
#       3. Copy the 16-character code (spaces do not matter)
#
#     Then replace the six lines above with:
#       EMAIL_PROVIDER=smtp
#       SMTP_HOST=smtp.gmail.com
#       SMTP_PORT=587
#       SMTP_USER=youraddress@gmail.com
#       SMTP_PASSWORD=the-16-char-app-password
#       SMTP_TLS=true
#       EMAIL_FROM=youraddress@gmail.com
#
#     Caveat for the report: mail arrives from a gmail.com address, so the
#     recipient sees a personal account rather than the product. Fine for a
#     demo, not for a real launch.
#
# (C) RESEND - needs a domain you own, plus SPF/DKIM/DMARC records.
#     See ACCOUNTS.md section 1.
RESEND_API_KEY=

# -- SMS / IP ---------------------------------------------------------
SMS_PROVIDER=console
IP_INTEL_PROVIDER=offline
IP_INTEL_API_KEY=

# -- Capacity and limits ----------------------------------------------
API_WORKERS=2
WORKER_CONCURRENCY=4
WORKER_MEM_LIMIT=768m
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_IP_PER_15MIN=30
RATE_LIMIT_FAIL_MODE=closed

# -- Monitoring -------------------------------------------------------
SENTRY_DSN=
METRICS_ENABLED=true
