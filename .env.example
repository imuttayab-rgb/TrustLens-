# =====================================================================
#  TrustLens - environment configuration
#  Copy to .env and replace every CHANGEME value.
#  Full reference: docs/12-environment-variables.md
# =====================================================================

# ── Core ─────────────────────────────────────────────────────────────
ENV=development
DEBUG=true
APP_NAME=TrustLens
APP_VERSION=0.1.0
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
LOG_LEVEL=DEBUG
LOG_FORMAT=console
TZ=UTC

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trustlens:trustlens@localhost:5432/trustlens
DATABASE_URL_SYNC=postgresql+psycopg://trustlens:trustlens@localhost:5432/trustlens
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=10000
DB_SSL_REQUIRE=false

# ── Redis ────────────────────────────────────────────────────────────
# Separate DB index for the queue so flushing the cache never drops jobs
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_URL=redis://localhost:6379/1
REDIS_MAX_CONNECTIONS=20
CACHE_TTL_SCORE_SECONDS=300
CACHE_TTL_DEFAULT_SECONDS=120

# ── Security ─────────────────────────────────────────────────────────
# Generate: openssl genpkey -algorithm ed25519 -out jwt.pem
#           openssl pkey -in jwt.pem -pubout -out jwt.pub
#           base64 -w0 jwt.pem  /  base64 -w0 jwt.pub
# Or simply: make -s keys   (see scripts/generate-keys.sh)
SECURITY_JWT_PRIVATE_KEY=CHANGEME_BASE64_ED25519_PRIVATE_KEY_PEM
SECURITY_JWT_PUBLIC_KEY=CHANGEME_BASE64_ED25519_PUBLIC_KEY_PEM
SECURITY_JWT_ALGORITHM=EdDSA
SECURITY_JWT_ISSUER=http://localhost:8000
SECURITY_JWT_AUDIENCE=trustlens-web
SECURITY_ACCESS_TOKEN_TTL_MINUTES=15
SECURITY_REFRESH_TOKEN_TTL_DAYS=30
SECURITY_REFRESH_IDLE_TTL_DAYS=7
SECURITY_PASSWORD_MIN_LENGTH=12
SECURITY_ARGON2_MEMORY_KIB=65536
SECURITY_ARGON2_TIME_COST=3
SECURITY_ARGON2_PARALLELISM=4
# openssl rand -base64 32  (each of these must be distinct)
SECURITY_OTP_PEPPER=CHANGEME_32_BYTE_RANDOM_BASE64
SECURITY_TOKEN_PEPPER=CHANGEME_32_BYTE_RANDOM_BASE64
# Signs public API responses so a marketplace can prove a score is ours (P6-04).
# Distinct from the token pepper: partners verify against this one, so its blast
# radius must not include session tokens. Leave empty to serve unsigned responses.
SECURITY_RESPONSE_SIGNING_SECRET=CHANGEME
SECURITY_RESPONSE_SIGNING_KEY_ID=s1
SECURITY_ENCRYPTION_KEY=CHANGEME_32_BYTE_RANDOM_BASE64
SECURITY_ENCRYPTION_KEY_ID=k1
SECURITY_API_KEY_PREFIX=tl_test
SECURITY_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SECURITY_TRUSTED_HOSTS=localhost,127.0.0.1
# How many proxy hops to trust in X-Forwarded-For. Wrong value => spoofable
# rate limits and a spoofable NETWORK signal. 0 when running without a proxy.
SECURITY_TRUSTED_PROXY_COUNT=0
# WARNING: no MFA enrolment or verification endpoint exists yet, so any role
# listed here CANNOT SIGN IN AT ALL - login returns MFA_REQUIRED with no way to
# satisfy it. The API refuses to boot if this is non-empty (see
# `_assert_mfa_roles_are_enrollable` in apps/api/src/trustlens_api/main.py).
# Leave this empty until MFA enrolment is built.
SECURITY_MFA_REQUIRED_ROLES=

# ── Google sign-in ───────────────────────────────────────────────────
# Optional: "Continue with Google" degrades to "not offered" (no code checks
# this at boot) when either is unset - Cloud Console -> APIs & Services ->
# Credentials -> OAuth client ID -> Web application. Redirect URI must be
# registered there exactly: {API_BASE_URL}/api/v1/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── AI ───────────────────────────────────────────────────────────────
# true => every AI port resolves to a deterministic fake. No keys, no internet.
USE_FAKE_AI=true
AI_PROVIDER=anthropic
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-sonnet-4-5
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
AI_MAX_OUTPUT_TOKENS=2048
AI_MONTHLY_BUDGET_USD=50
AI_PROMPT_VERSION=v1

OCR_ENGINE=easyocr
OCR_LANGUAGES=en,ur
OCR_MIN_CONFIDENCE=0.60
OCR_GPU=false

FACE_MATCH_MODEL=ArcFace
FACE_DETECTOR_BACKEND=retinaface
FACE_MATCH_THRESHOLD=0.70
# 0.55-0.70 routes to manual review rather than an automatic fail
FACE_MATCH_REVIEW_LOWER=0.55

CLASSIFIER_MODEL_VERSION=scamclf-v1
CLASSIFIER_THRESHOLD=0.65

# ── Object storage ───────────────────────────────────────────────────
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT_URL=http://localhost:9002
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET_DOCUMENTS=trustlens-documents
STORAGE_BUCKET_LISTINGS=trustlens-listings
STORAGE_BUCKET_MODELS=trustlens-models
STORAGE_PRESIGN_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_ALLOWED_MIME=image/jpeg,image/png,image/webp
MEDIA_RETENTION_DAYS_IDENTITY=90

# ── Communications ───────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@trustlens.dev
EMAIL_FROM_NAME=TrustLens
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
RESEND_API_KEY=

SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_SEND_LIMIT_HOUR=3
OTP_SEND_LIMIT_DAY=10

# ── Signal enrichment ────────────────────────────────────────────────
IP_INTEL_PROVIDER=offline
IP_INTEL_API_KEY=
IP_INTEL_TIMEOUT_SECONDS=5
IP_INTEL_CACHE_TTL_SECONDS=86400
DISPOSABLE_EMAIL_LIST_URL=
PHONE_LOOKUP_PROVIDER=none

# ── Queue & jobs ─────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
WORKER_MAX_JOBS=100
JOB_DEFAULT_TIMEOUT_SECONDS=120
JOB_IDENTITY_TIMEOUT_SECONDS=300
JOB_MAX_TRIES=3

# ── Scoring ──────────────────────────────────────────────────────────
SCORE_VALIDITY_DAYS=30
# Below this much evaluated weight the verdict is UNKNOWN, never HIGH risk
SCORE_MIN_EVIDENCE_WEIGHT=40
SCORE_RECOMPUTE_DEBOUNCE_SECONDS=10

# ── Rate limiting ────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=false
RATE_LIMIT_ANON_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_15MIN=5
RATE_LIMIT_PUBLIC_API_FREE_PER_MINUTE=60
RATE_LIMIT_PUBLIC_API_PARTNER_PER_MINUTE=600
RATE_LIMIT_FAIL_MODE=closed

# ── Observability ────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=trustlens-api
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=

# ── Frontend (apps/web, apps/admin) ──────────────────────────────────
# NEXT_PUBLIC_* is compiled into the browser bundle. Never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_SENTRY_DSN=
API_BASE_URL_INTERNAL=http://localhost:8000
SESSION_COOKIE_NAME=tl_rt
SESSION_COOKIE_DOMAIN=localhost
REVALIDATE_SECRET=CHANGEME_RANDOM_STRING
