* text=auto eol=lf
# Windows batch files must keep CRLF. cmd.exe mis-parses LF-only .bat
# files - the classic symptom is a label or a multi-line block silently
# doing nothing, which is very hard to debug from the output.
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.svg binary
*.pdf binary
pnpm-lock.yaml linguist-generated=true -diff
uv.lock linguist-generated=true -diff
packages/api-client/src/schema.gen.ts linguist-generated=true -diff
docs/api/openapi.json linguist-generated=true -diff
